{
  "group": "model",
  "label": "建模",
  "order": 20,
  "tools": [
    {
      "name": "nx_block",
      "s": "长方体（可布尔）",
      "k": ["方块", "长方体", "block", "box"],
      "desc": "按原点+边长创建长方体；可 unite/subtract/intersect 到目标体。",
      "next": "失败先 nx_errors 或 nx_inspect；目标体用 last 或几何描述",
      "route": { "kind": "nx", "cmd": "nx_block" },
      "flags": { "gate": true, "verify": true, "expstep": true },
      "schema": {
        "type": "object",
        "required": ["length", "width", "height"],
        "properties": {
          "x": { "type": "number" }, "y": { "type": "number" }, "z": { "type": "number" },
          "length": { "type": "number" }, "width": { "type": "number" }, "height": { "type": "number" },
          "boolean": { "type": "string", "enum": ["create", "unite", "subtract", "intersect"] },
          "target": { "type": "string", "description": "last / JournalIdentifier" }
        },
        "additionalProperties": false
      },
      "matrix": { "nx10": "expected", "nx2512": "expected" }
    },
    {
      "name": "nx_extrude",
      "s": "闭合轮廓点拉伸成实体",
      "k": ["拉伸", "extrude"],
      "desc": "把 points 给出的闭合轮廓（至少 3 点，自动闭合）沿方向拉伸 distance。",
      "next": "点要共面且不共线；失败先检查轮廓是否闭合",
      "route": { "kind": "nx", "cmd": "nx_extrude" },
      "flags": { "gate": true, "verify": true, "expstep": true },
      "schema": {
        "type": "object",
        "required": ["points", "distance"],
        "properties": {
          "points": { "type": "array", "items": { "type": "array", "items": { "type": "number" } } },
          "distance": { "type": "number" },
          "direction": { "type": "array", "items": { "type": "number" } },
          "draft": { "type": "number" }
        },
        "additionalProperties": false
      },
      "matrix": { "nx10": "expected", "nx2512": "expected" }
    },
    {
      "name": "nx_revolve",
      "s": "闭合轮廓点旋转成实体",
      "k": ["旋转", "回转", "revolve"],
      "desc": "把 points 给出的闭合轮廓绕轴旋转 angle 度（默认 360）。",
      "next": "轴用 axis_point + axis_dir；轮廓不能跨轴",
      "route": { "kind": "nx", "cmd": "nx_revolve" },
      "flags": { "gate": true, "verify": true, "expstep": true },
      "schema": {
        "type": "object",
        "required": ["points", "angle"],
        "properties": {
          "points": { "type": "array", "items": { "type": "array", "items": { "type": "number" } } },
          "angle": { "type": "number" },
          "axis_point": { "type": "array", "items": { "type": "number" } },
          "axis_dir": { "type": "array", "items": { "type": "number" } }
        },
        "additionalProperties": false
      },
      "matrix": { "nx10": "expected", "nx2512": "expected" }
    },
    {
      "name": "nx_hole",
      "s": "打孔（圆柱减料）",
      "k": ["孔", "hole", "钻孔"],
      "desc": "按位置/方向/直径在目标体上做通孔或指定深度孔（圆柱减料，零件导航器显示为圆柱特征）。",
      "next": "位置不确定先 nx_inspect point=[x,y,z]",
      "route": { "kind": "nx", "cmd": "nx_hole" },
      "flags": { "gate": true, "verify": true, "expstep": true },
      "schema": {
        "type": "object",
        "required": ["target", "position", "diameter"],
        "properties": {
          "target": { "type": "string" },
          "position": { "type": "array", "items": { "type": "number" } },
          "diameter": { "type": "number" },
          "depth": { "type": "number", "description": "省略=通孔" },
          "direction": { "type": "array", "items": { "type": "number" } }
        },
        "additionalProperties": false
      },
      "matrix": { "nx10": "expected", "nx2512": "expected" }
    },
    {
      "name": "nx_fillet",
      "s": "边倒圆",
      "k": ["圆角", "倒圆", "fillet", "blend"],
      "desc": "对目标体指定位置的边倒圆。",
      "next": "边点位置不准先 nx_measure 或 nx_inspect",
      "route": { "kind": "nx", "cmd": "nx_fillet" },
      "flags": { "gate": true, "verify": true, "expstep": true },
      "schema": {
        "type": "object",
        "required": ["target", "radius"],
        "properties": {
          "target": { "type": "string" },
          "radius": { "type": "number" },
          "edges": { "type": "array", "items": { "type": "array", "items": { "type": "number" } } }
        },
        "additionalProperties": false
      },
      "matrix": { "nx10": "expected", "nx2512": "expected" }
    },
    {
      "name": "nx_chamfer",
      "s": "边倒斜角",
      "k": ["倒角", "chamfer"],
      "desc": "对目标体指定位置的边倒斜角。",
      "next": "对称 C 角用 width；失败先减小 width",
      "route": { "kind": "nx", "cmd": "nx_chamfer" },
      "flags": { "gate": true, "verify": true, "expstep": true },
      "schema": {
        "type": "object",
        "required": ["target", "width"],
        "properties": {
          "target": { "type": "string" },
          "width": { "type": "number" },
          "edges": { "type": "array", "items": { "type": "array", "items": { "type": "number" } } }
        },
        "additionalProperties": false
      },
      "matrix": { "nx10": "expected", "nx2512": "expected" }
    },
    {
      "name": "nx_boolean",
      "s": "布尔运算",
      "k": ["布尔", "求和", "求差", "boolean", "unite", "subtract"],
      "desc": "目标体与工具体做 unite/subtract/intersect。",
      "next": "两体必须相交；失败先 nx_inspect 看包围盒",
      "route": { "kind": "nx", "cmd": "nx_boolean" },
      "flags": { "gate": true, "verify": true, "expstep": true },
      "schema": {
        "type": "object",
        "required": ["target", "tool", "operation"],
        "properties": {
          "target": { "type": "string" },
          "tool": { "type": "string" },
          "operation": { "type": "string", "enum": ["unite", "subtract", "intersect"] }
        },
        "additionalProperties": false
      },
      "matrix": { "nx10": "expected", "nx2512": "expected" }
    },
    {
      "name": "nx_move_face",
      "s": "移动面（偏移）",
      "k": ["移动面", "偏置面", "move face", "offset"],
      "desc": "把目标体的选定面沿向量移动/偏置。",
      "next": "面选择用点列表；失败先 nx_inspect 确认面法向",
      "route": { "kind": "nx", "cmd": "nx_move_face" },
      "flags": { "gate": true, "verify": true, "expstep": true },
      "schema": {
        "type": "object",
        "required": ["target", "delta"],
        "properties": {
          "target": { "type": "string" },
          "delta": { "type": "array", "items": { "type": "number" } },
          "faces": { "type": "array", "items": { "type": "array", "items": { "type": "number" } } }
        },
        "additionalProperties": false
      },
      "matrix": { "nx10": "expected", "nx2512": "expected" }
    },
    {
      "name": "nx_shell",
      "s": "抽壳（指定开口面）",
      "k": ["抽壳", "壳", "shell", "减料"],
      "desc": "把目标体抽成壁厚 thickness 的壳，faces 给出要开口的面附近点。",
      "next": "默认公差 0.01；失败先换 thickness 或检查开口面",
      "route": { "kind": "nx", "cmd": "nx_shell" },
      "flags": { "gate": true, "verify": true, "expstep": true },
      "schema": {
        "type": "object",
        "required": ["target", "thickness", "faces"],
        "properties": {
          "target": { "type": "string" },
          "thickness": { "type": "number" },
          "faces": { "type": "array", "items": { "type": "array", "items": { "type": "number" } } },
          "tolerance": { "type": "number" }
        },
        "additionalProperties": false
      },
      "matrix": { "nx10": "expected", "nx2512": "expected" }
    },
    {
      "name": "nx_delete_body",
      "s": "删除体",
      "k": ["删除体", "删体", "delete body"],
      "desc": "删除目标体（清理工具体/废体）。",
      "next": "删完用 nx_inspect 确认剩余体",
      "route": { "kind": "nx", "cmd": "nx_delete_body" },
      "flags": { "gate": true, "expstep": true },
      "schema": {
        "type": "object",
        "required": ["target"],
        "properties": {
          "target": { "type": "string" }
        },
        "additionalProperties": false
      },
      "matrix": { "nx10": "expected", "nx2512": "expected" }
    }
  ]
}
